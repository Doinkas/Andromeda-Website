rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdminEmail() {
      let allowlistDoc = firestore.get(/databases/(default)/documents/config/adminAllowlist);
      return request.auth != null
        && request.auth.token.email is string
        && allowlistDoc.data != null
        && allowlistDoc.data.emails != null
        && allowlistDoc.data.emails[request.auth.token.email] == true;
    }

    function isCaptainClaim() {
      return request.auth != null
        && (
          request.auth.token.captain == true
          || (request.auth.token.role is string
            && (request.auth.token.role == 'captain' || request.auth.token.role == 'admin'))
        );
    }

    function isAdminOrCaptain() {
      return isAdminEmail() || isCaptainClaim();
    }

    match /scrims/{teamId}/{matchId}/{fileName} {
      allow read: if isAdminOrCaptain();
      allow write: if isAdminOrCaptain()
        && request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|jpg|webp)');
    }

    match /officials/{teamId}/{matchId}/{fileName} {
      allow read: if true;
      allow write: if isAdminOrCaptain()
        && request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|jpg|webp)');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
